# Copy to .env and update secrets before production deployment

# PostgreSQL
POSTGRES_USER=bace_user
POSTGRES_PASSWORD=bace_password
POSTGRES_DB=bace_devotee_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bace_user:bace_password@db:5432/bace_devotee_db?schema=public

# Backend
BACKEND_PORT=5000
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=30d
ADMIN_EMAIL=admin@bace.org
ADMIN_PASSWORD=admin108

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# pgAdmin (optional)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@bace.local
PGADMIN_PASSWORD=admin123

# Cloudinary (optional — for future cloud uploads)
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=
